{
  "name": "try-md",
  "version": "1.0.0",
  "private": true,
  "description": "try-md",
  "author": "Uday Pandey",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "deploy": "gatsby build --prefix-paths && gh-pages -f -d public",

    "review_all":          "GATSBY_REVIEW_MODE=all              npx gatsby develop",

    "review_answers_p0":   "GATSBY_REVIEW_MODE=answers_p0       npx gatsby develop",
    "review_answers_p1":   "GATSBY_REVIEW_MODE=answers_p1       npx gatsby develop",
    "review_answers_p2":   "GATSBY_REVIEW_MODE=answers_p2       npx gatsby develop",
    "review_answers":      "GATSBY_REVIEW_MODE=answers_all      npx gatsby develop",

    "review_questions_p0": "GATSBY_REVIEW_MODE=questions_p0     npx gatsby develop",
    "review_questions_p1": "GATSBY_REVIEW_MODE=questions_p1     npx gatsby develop",
    "review_questions_p2": "GATSBY_REVIEW_MODE=questions_p2     npx gatsby develop",
    "review_questions":    "GATSBY_REVIEW_MODE=questions_all    npx gatsby develop"
  },
  "dependencies": {
    "gatsby": "^4.14.1",
    "gatsby-plugin-react-helmet": "^5.14.0",
    "gatsby-remark-katex": "^6.14.0",
    "gatsby-remark-prismjs": "^6.17.0",
    "gatsby-source-filesystem": "^4.14.0",
    "gatsby-transformer-remark": "^5.14.0",
    "katex": "^0.13.24",
    "prismjs": "^1.28.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-helmet": "^6.1.0"
  },
  "devDependencies": {
    "gh-pages": "^4.0.0"
  }
}
