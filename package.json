{
  "name": "@rtq/review-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "repository-paths:test": "pnpm --filter @rtq/review-repository-paths test",
    "review-web:dev": "pnpm --filter rtq-review-web dev --port 3000",
    "review-tag-web:dev": "pnpm --filter rtq-review-tag-web dev --port 3001",
    "review-question-viewer-web:dev": "pnpm --filter rtq-review-question-viewer-web dev --port 3002",
    "review-legacy-gatsby-web:dev": "pnpm --filter rtq-review-gatsby-web develop",
    "review-api:dev": "pnpm --filter rtq-review-api dev",
    "review-api:dependencies:check": "pnpm --filter rtq-review-api dependencies:check",
    "review-api:syntax:check": "pnpm --filter rtq-review-api syntax:check"
  }
}
