# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime-copied review content
/md/*
!/md/.gitkeep
/public/assets/*
!/public/assets/.gitkeep
!/public/assets/papers/
/public/assets/papers/*
!/public/assets/papers/missing/
/public/assets/papers/missing/*
!/public/assets/papers/missing/missing_image.svg
